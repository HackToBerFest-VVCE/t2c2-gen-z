# FieldPilot Backend Environment Variables
APP_NAME="FieldPilot OfflineFirst AI"
VERSION="1.0.0"
API_PREFIX="/api"
DATABASE_URL="sqlite:///./fieldpilot.db"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Secure Server-Side Gemini AI Configuration
# Note: Keep this key server-side only. Never expose to client bundles or commit to git.
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODE=hybrid
